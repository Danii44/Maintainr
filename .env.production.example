# Maintainr PostgreSQL-first production template
# Never commit real secrets. Add them through your deployment provider's secret manager.

# Database: PostgreSQL connection string, for example:
# postgresql://USER:PASSWORD@HOST:5432/maintainr?sslmode=require
DATABASE_URL=

# Session/auth values. Replace Manus OAuth before independent release.
JWT_SECRET=
AUTH_SECRET=
AUTH_BASE_URL=https://app.example.com

# Email delivery
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=notifications@example.com

# Optional SMS delivery; keep disabled until every value is configured and tested.
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Scheduled reminder callback
REMINDER_CALLBACK_SECRET=
REMINDER_CALLBACK_BASE_URL=https://app.example.com

# Public branding defaults; organization-specific branding lives in developer settings.
VITE_APP_TITLE=Maintainr
VITE_APP_LOGO=

# Production checklist:
# 1. Import POSTGRESQL_SCHEMA.sql into an empty PostgreSQL database.
# 2. Set DATABASE_URL using the deployment provider's secret manager.
# 3. Configure an independent authentication provider and remove Manus OAuth variables.
# 4. Configure Resend and optionally Twilio.
# 5. Configure the scheduled worker/cron callback.
# 6. Configure the domain, SSL, backups, and monitoring.
