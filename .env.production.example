# Maintainr production configuration template
# Add real values through managed project secrets; do not commit credentials.

# Email delivery
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# Optional SMS delivery; keep disabled until all values are configured.
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional Firebase readiness; leave blank when using the current MySQL/TiDB backend.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=

# Production notes:
# - Database, OAuth, JWT, built-in storage, and application identity values are managed by the platform.
# - Branding and notification channel toggles are controlled from Developer Settings.
# - Publish the project before expecting scheduled reminder callbacks to run.
